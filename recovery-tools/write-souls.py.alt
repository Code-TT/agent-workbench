def zerlegen(text: str) -> str:
    """Vorhandenen Rolleninhalt behalten, generierten Block und Rollenblock entfernen (idempotent)."""
    marker = "<!-- GEMEINSAMER BLOCK"
    if marker in text:
        text = text[text.index(marker):]
        text = text[text.index("\n---\n")+5:] if "\n---\n" in text else ""
    else:
        lines = text.splitlines()
        start = next((i for i, l in enumerate(lines) if l.startswith("## Projektworkflow")), None)
        if start is not None:
            end = next((j for j in range(start+1, len(lines)) if lines[j].startswith("# ")), len(lines))
            text = "\n".join(lines[:start] + lines[end:])
    if "\n---\n" in text:            # alten Rollenblock abschneiden
        text = text.split("\n---\n")[0]
    return text.strip()


def main():
    geschrieben, fehlend = [], []
    for name, block in ROLES.items():
        d = PROF / name
        if not d.is_dir():
            fehlend.append(name); continue
        soul = d / "SOUL.md"
        alt = zerlegen(soul.read_text()) if soul.exists() else ""
        if soul.exists():
            shutil.copy2(soul, soul.with_suffix(f".md.bak-{TS}"))
        soul.write_text(COMMON + "\n\n" + alt + "\n\n---\n\n" + block)
        geschrieben.append((name, len(soul.read_text())))
    print(f"{'Bot':18s} Groesse")
    for n, s in geschrieben:
        print(f"{n:18s} {s:5d} Zeichen")
    if fehlend:
        print("Nicht gefunden:", ", ".join(fehlend))

if __name__ == "__main__":
    main()
