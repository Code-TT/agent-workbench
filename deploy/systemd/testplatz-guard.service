[Unit]
Description=Testplatz-Slot-Housekeeping (abgelaufene Leases, verwaiste Slot-Prozesse)
Documentation=https://github.com/Code-TT/agent-workbench
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=TESTSLOT_STATE_DIR=/var/lib/testplatz
Environment=TESTSLOT_POLICY=/etc/testplatz/slots.conf
WorkingDirectory=/srv/agent-workbench/testplatz
ExecStart=/usr/bin/python3 -m testslot_manager guard
